# Copy to .env and fill in. Generate each key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit .env. Keep a copy of DATA_KEY offline: without it encrypted data cannot be read.
NODE_ENV=production
DATA_KEY=
PEPPER=
URL_SIGNING_KEY=
# Shared HMAC key between the api and the AI verifier. Put the same line, and nothing else,
# in .env.verifier: the verifier container gets only that file.
VERIFIER_KEY=
# Optional key rotation: DATA_KEYS={"k1":"old-base64","k2":"new-base64"} and DATA_KEY_ID=k2
