# Local use: open http://localhost:3000
# Data is saved in ./data/kidsway.db. Secret keys are in .env.local (created on first run).
# No SMS provider is set, so the login code is shown on screen ("SMS not connected").
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/kidsway.db
DEV_OTP_ECHO=1
DEV_ADMIN_PHONE=+60100000000
DEV_RELAX_IP_LIMITS=1
# Hiring: approval of a new Guardian needs two different vetting officers (four-eyes).
VETTING_APPROVALS=2
DEV_OFFICER2_PHONE=+60100000001
# AI identity check: the Python verifier (see verifier/README.md). If it is not running,
# applications simply go to an officer for a manual identity check.
VERIFIER_URL=http://127.0.0.1:5091
